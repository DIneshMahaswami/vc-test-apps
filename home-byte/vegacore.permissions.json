{
    "roles": {
        "super_admin": {
            "name": "Super Admin",
            "description": "Super Admins have access to everything"
        },
        "admin": {
            "name": "Admin",
            "description": "Admins have access to most things"
        },
        "sales": {
            "name": "Sales"
        },
        "contractor": {
            "name": "Contractor"
        },
        "customer": {
            "name": "Customer"
        }
    },
    "permissions": {
        "super_admin": {
            "*": [
                "*"
            ]
        },
        "admin": {
            "document_templates": [
                "*"
            ],
            "digital_signatures": [
                "*"
            ],
            "error_logs": [
                "list"
            ],
            "history": [
                "list",
                "show",
                "restoreHistory"
            ],
            "users": [
                "*"
            ],
            "properties": [
                "*"
            ],
            "units": [
                "*"
            ],
            "customers": [
                "*"
            ],
            "rental_agreements": [
                "*"
            ],
            "leads": [
                "*"
            ],
            "invoices": [
                "*"
            ],
            "payments": [
                "*"
            ],
            "contractors": [
                "*"
            ],
            "service_requests": [
                "*"
            ],
            "work_orders": [
                "*"
            ]
        },
        "sales": {
            "leads": [
                "*"
            ],
            "properties": [
                "list",
                "show"
            ],
            "units": [
                "list",
                "show"
            ],
            "customers": [
                "list",
                "show",
                "create",
                "edit"
            ],
            "rental_agreements": [
                "list",
                "show",
                "create",
                "edit"
            ],
            "invoices": [
                "list",
                "show"
            ]
        },
        "contractor": {
            "work_orders": {
                "actions": [
                    "list",
                    "show",
                    "edit"
                ],
                "columns": {
                    "readonly": [
                        "work_order_amount",
                        "contractor_id",
                        "unit_id"
                    ]
                },
                "row_scope": "contractors"
            }
        },
        "customer": {
            "rental_agreements": {
                "actions": [
                    "list",
                    "show"
                ],
                "row_scope": "customers"
            },
            "invoices": {
                "actions": [
                    "list",
                    "show"
                ],
                "row_scope": "rental_agreements.customers"
            },
            "payments": {
                "actions": [
                    "list",
                    "show"
                ],
                "row_scope": "invoices.rental_agreements.customers"
            },
            "service_requests": {
                "actions": [
                    "*"
                ],
                "row_scope": "customers"
            }
        }
    }
}